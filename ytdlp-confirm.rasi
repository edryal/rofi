@import "shared-colors.rasi"

* {
    font: "JetBrains Mono Nerd Font 11.5";
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            480px;
    enabled:          true;
    border:           2px solid;
    border-color:     @accent-dim;
    border-radius:    18px;
    cursor:           "default";
    background-color: @bg-1;
}

mainbox {
    enabled:          true;
    spacing:          20px;
    padding:          26px;
    background-color: transparent;
    orientation:      vertical;
    children:         [ "imagebox", "message", "listview" ];
}

imagebox {
    padding:          0px;
    border-radius:    12px;
    background-color: @bg-2;
    orientation:      vertical;
    children:         [ "dummy" ];
}

dummy {
    background-color: transparent;
}

message {
    enabled:          true;
    background-color: transparent;
}

textbox {
    padding:          0px;
    background-color: transparent;
    text-color:       @fg;
    vertical-align:   0.5;
    horizontal-align: 0.5;
    markup:           true;
}

listview {
    enabled:          true;
    columns:          1;
    lines:            8;
    cycle:            true;
    dynamic:          false;
    scrollbar:        true;
    layout:           vertical;
    fixed-height:     true;
    fixed-columns:    true;
    spacing:          10px;
    background-color: transparent;
    text-color:       @fg;
    cursor:           "default";
}

scrollbar {
    background-color:        @bg-2;
    handle-color:            @accent;
    handle-width:            8px;
    handle-rounded-corners:  true;
    border-radius:           10px;
}

element {
    enabled:          true;
    spacing:          16px;
    padding:          15px 18px;
    border:           0px solid;
    border-radius:    12px;
    background-color: @bg-2;
    text-color:       @fg;
    cursor:           pointer;
}

element selected.normal {
    background-color: @accent;
    text-color:       @on-accent;
}

element-icon {
    size: 0;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}
